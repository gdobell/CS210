// loading in libraries 
#include <iostream>
#include <vector>
#include <unordered_map>
using namespace std;


// This is the hash table method 
class Solution {
public:
// defining the method signature, in c++ its called a function signature
// method signature needs: parameter type, name of the method, return type 
// return type is vector of ints, vector back type of peorblems  
    vector<int> twoSum(const vector<int>& nums, int target) {
        // return type, method name, parameter list 

        // & means pass by reference: not passing the copy of it, but using the object itself
        // by passing in a reference to where the object is in memory

        // calling the method 
        unordered_map<int, int> index;
        // index is the variable name and the type is an unordered_map from int to int

        for (int i = 0; i < nums.size(); ++i) {
            int needed = target - nums[i];
            // if we want 10 and we are looking at 4, then our needed is 6
            // now we know what we need

            // this is using hash tables 
            // or use two for loops 
            if (index.count(needed)) {
                // now we go searching for what we need 
                return {index[needed], i}
                // if it finds it, then it returns a vector of the index of the needed value and key(i)

            }
            index[nums[i]] = i;
            // then this changes it to return still the needed value's index as well as the index for i. So it returns the coordinates to the numbers we need in the map. indices 
        }

        return {}; // no solution found 
        // would return an empty vector and the notation for that is {}
        // {} is a vector literal 
        // boolean literal = true 
        // boolean variable = a name that points to something that will be T or F
        // int literal is 7 or 9 
        // int variable is a that could be assigned 7 or 9
        // > is a boolean expression  
    }

    int main() {
        vector<int> nums = {2, 7, 11, 15};
        int target = 9;

        vector<int> answer = twoSum{nums, target};
        // nums and target are now arguments 

        if (!answer.empty()) {
            cout << answer = twoSum(nums, target);
        }
    }
};
